# Copy to .env.workbench; keep the existing .env untouched.
# For Compose, replace this placeholder with a strong, unique local demo password.
WB_SQL_PASSWORD=
WB_SQL_SERVER=sqlserver,1433
# P01 uses only SELECT and session-local temporary tables in master.
# P03 will create the application database and a restricted runtime login.
WB_SQL_DATABASE=master
WB_SQL_USERNAME=sa
WB_SQL_DRIVER=mssql-python
WB_SQL_CONNECT_TIMEOUT=5
# Development container uses a self-signed certificate. Keep encryption on.
WB_SQL_TRUST_CERTIFICATE=true
