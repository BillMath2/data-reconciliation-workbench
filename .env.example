# Copy to .env.workbench; keep the existing .env untouched.
# For Compose, supply two different strong passwords, or run initialize-demo.ps1.
WB_SQL_PASSWORD=
WB_SQL_RUNTIME_PASSWORD=
WB_SQL_SERVER=sqlserver,1433
# Direct Python commands use the admin login for explicit database setup.
# Compose's workbench service uses workbench_app and the separate runtime password.
WB_SQL_DATABASE=workbench
WB_SQL_USERNAME=sa
WB_SQL_DRIVER=mssql-python
WB_SQL_CONNECT_TIMEOUT=5
# Development container uses a self-signed certificate. Keep encryption on.
WB_SQL_TRUST_CERTIFICATE=true

# Optional P05A live explanation. Never needed for stub mode or ordinary CI.
# Only loaded from the process or an explicitly selected --env-file.
OPENAI_API_KEY=
